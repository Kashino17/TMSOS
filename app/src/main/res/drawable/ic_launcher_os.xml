<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep, Apple-like graphite glass -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="4"
                android:endX="98"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF28304C" />
                <item android:offset="0.46" android:color="#FF11131E" />
                <item android:offset="1.0" android:color="#FF05060A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft light source in the upper left, like light hitting glass -->
    <path android:pathData="M12,0 C36,0 54,18 54,42 C54,58 44,70 30,76 C14,82 0,72 0,54 L0,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="4"
                android:endX="48"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#33A9C8FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White T monogram -->
    <path
        android:pathData="M33,27 H75 A5,5 0,0 1,80 32 V36 A5,5 0,0 1,75 41 H61 V78 A5,5 0,0 1,56 83 H52 A5,5 0,0 1,47 78 V41 H33 A5,5 0,0 1,28 36 V32 A5,5 0,0 1,33 27 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="27"
                android:endX="80"
                android:endY="83"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.65" android:color="#FFF2F7FF" />
                <item android:offset="1.0" android:color="#FFBFD6FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fine top rim -->
    <path
        android:pathData="M0,1 H108"
        android:strokeWidth="1"
        android:strokeColor="#24FFFFFF" />
</vector>
